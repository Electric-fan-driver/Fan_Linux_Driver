/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/gpio/gpio.h>

/ {
    overlay-name = "kcci fan project";
    compatible = "nvidia,p3768-0000+p3767-0005", "nvidia,p3768-0000+p3767-0005-super";   /* 보드 compatible로 수정 */

    fragment@0 {
        target-path = "/";
        __overlay__ {
            fan_input {                                  /* A */
                compatible = "kcci,fan-input";
                power-gpios     = <&gpio TEGRA234_MAIN_GPIO(Q, 5) GPIO_ACTIVE_LOW>;
                swing-gpios     = <&gpio TEGRA234_MAIN_GPIO(Q, 6) GPIO_ACTIVE_LOW>;
                enc-fan-gpios   = <&gpio TEGRA234_MAIN_GPIO(R, 4)  GPIO_ACTIVE_HIGH>,   /* A  */
                                  <&gpio TEGRA234_MAIN_GPIO(R, 5)  GPIO_ACTIVE_HIGH>,   /* B  */
                                  <&gpio TEGRA234_MAIN_GPIO(AC, 6) GPIO_ACTIVE_LOW>;    /* SW */
                enc-timer-gpios = <&gpio TEGRA234_MAIN_GPIO(H, 7) GPIO_ACTIVE_HIGH>,
                                  <&gpio TEGRA234_MAIN_GPIO(I, 2) GPIO_ACTIVE_HIGH>,
                                  <&gpio TEGRA234_MAIN_GPIO(I, 1) GPIO_ACTIVE_LOW>;
                debounce-ms = <20>;
                pinctrl-names = "default";
                pinctrl-0 = <&fan_input_pins>;
            };
            fan_led {                                    /* A */
                compatible = "kcci,fan-led";
                led-gpios = <&gpio TEGRA234_MAIN_GPIO(Y, 0) GPIO_ACTIVE_HIGH>,
                            <&gpio TEGRA234_MAIN_GPIO(Y, 4) GPIO_ACTIVE_HIGH>,
                            <&gpio TEGRA234_MAIN_GPIO(Y, 3) GPIO_ACTIVE_HIGH>,
                            <&gpio TEGRA234_MAIN_GPIO(Y, 1) GPIO_ACTIVE_HIGH>;
                pinctrl-names = "default";
                pinctrl-0 = <&fan_led_pins>;
            };
            fan_motor {                                  /* C */
                compatible = "kcci,fan-motor";
                pwms = <&pwm7 0 50000>;                  /* 20 kHz */
                dir-gpios = <&gpio TEGRA234_MAIN_GPIO(Y, 2) GPIO_ACTIVE_HIGH>,   /* IN1 */
                            <&gpio TEGRA234_MAIN_GPIO(I, 0) GPIO_ACTIVE_HIGH>;   /* IN2 */
                pinctrl-names = "default";
                pinctrl-0 = <&fan_motor_pins>;
            };
            fan_servo {                                  /* C */
                compatible = "kcci,fan-servo";
                pwms = <&pwm5 0 5000000>;
                min-pulse-us = <500>;
                max-pulse-us = <2500>;
                swing-min-deg = <30>;
                swing-max-deg = <150>;
            };
        };
    };

    fragment@10 {
        target = <&pinmux>;
        __overlay__ {
            fan_motor_pins: fan-motor-pins {
                in1 { nvidia,pins = "spi3_mosi_py2";  nvidia,function = "rsvd1"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
                in2 { nvidia,pins = "soc_gpio42_pi0"; nvidia,function = "rsvd2"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
            };
            fan_led_pins: fan-led-pins {
                led1 { nvidia,pins = "spi3_sck_py0"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
                led2 { nvidia,pins = "spi3_cs1_py4"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
                led3 { nvidia,pins = "spi3_cs0_py3"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
                led4 { nvidia,pins = "spi3_miso_py1"; nvidia,gpio-mode = <0>; nvidia,pull = <1>; nvidia,tristate = <0>; nvidia,enable-input = <0>; nvidia,open-drain = <0>; };
            };
            fan_input_pins: fan-input-pins {
                btn-power { nvidia,pins = "soc_gpio32_pq5"; nvidia,gpio-mode = <0>; nvidia,pull = <0>; nvidia,tristate = <1>; nvidia,enable-input = <1>; nvidia,schmitt = <1>; };
                btn-swing { nvidia,pins = "soc_gpio33_pq6"; nvidia,gpio-mode = <0>; nvidia,pull = <0>; nvidia,tristate = <1>; nvidia,enable-input = <1>; nvidia,schmitt = <1>; };
            };
        };
    };

    fragment@1 {                                         /* B */
        target-path = "/bus@0/i2c@c250000";              /* i2c-7, 확인 필요 */
        __overlay__ {
            #address-cells = <1>;
            #size-cells = <0>;
            bmp180@77 { compatible = "kcci,bmp180";  reg = <0x77>; };
        };
    };

    fragment@2 { 
	target-path = "/bus@0/i2c@c240000";
	__overlay__ {
	    #address-cells = <1>;
	    #size-cells = <0>;
            lcd1602a@27 { compatible = "kcci,lcd1602"; reg = <0x27>; };
        };    
    };

    fragment@3 { target = <&pwm7>; __overlay__ { status = "okay"; }; };
    fragment@4 { target = <&pwm5>; __overlay__ { status = "okay"; }; };

    /* pinmux(입력 허용 등)는 보드 DT에서 핀 노드 이름을 확인해 추가한다 (12장) */
};